<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Calculator.Converters"
        xmlns:vm="clr-namespace:Calculator.ViewModels"
        mc:Ignorable="d"
        Title="Calculator" Height="700" Width="440"
        MinWidth="380" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" IsInverted="True" />
    </Window.Resources>

    <!-- Main Outer Border -->
    <Border Background="{DynamicResource BgObsidianBrush}"
            BorderBrush="{DynamicResource BorderGlowBrush}"
            BorderThickness="1"
            CornerRadius="20"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.6" />
        </Border.Effect>

        <Grid x:Name="MainRootGrid" Focusable="True">
            <Grid.RowDefinitions>
                <!-- Row 0: Header / Chrome -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Action Bar (Mode, Theme & History Toggles) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Display Panel -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Scientific Keypad (Optional) -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Main Keypad -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ROW 0: Title Bar & Chrome -->
            <Grid Grid.Row="0" Background="{DynamicResource WindowHeaderGradient}" MouseDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,10">
                    <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource NeonCyanBrush}" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="CALCULATOR" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" Content="─" ToolTip="Minimize" />
                    <Button Style="{StaticResource WindowControlButton}" Click="MaximizeButton_Click" Content="🗖" ToolTip="Maximize / Restore" />
                    <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" Content="✕" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ROW 1: Mode Selector, Theme Switcher & History Bar -->
            <Grid Grid.Row="1" Margin="16,8,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Mode Toggle Button -->
                <Button Grid.Column="0" Command="{Binding ToggleModeCommand}" Style="{StaticResource HeaderIconButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙ " FontSize="14" Foreground="{DynamicResource NeonCyanBrush}" />
                        <TextBlock Text="{Binding ModeTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Theme Toggle Button -->
                <Button Grid.Column="1" Command="{Binding ToggleThemeCommand}" Style="{StaticResource HeaderIconButton}" ToolTip="Toggle Light/Dark Theme">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ThemeIcon}" FontSize="14" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ThemeTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- History Toggle Button -->
                <Button Grid.Column="3" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource HeaderIconButton}" ToolTip="Calculation History">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜 " FontSize="14" />
                        <TextBlock Text="History" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ROW 2: Display Panel -->
            <Border Grid.Row="2" Margin="16,4,16,12"
                    Background="{DynamicResource BgGlassPanelBrush}"
                    BorderBrush="{DynamicResource BorderGlowBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>

                    <!-- Formula / Expression Line -->
                    <TextBlock Grid.Row="0" Text="{Binding ExpressionText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="15" FontWeight="Medium"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Main Result / Operand Display -->
                    <Viewbox Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="Bold" FontSize="42"
                                   FontFamily="Segoe UI, Inter" />
                    </Viewbox>
                </Grid>
            </Border>

            <!-- ROW 3: Scientific Keypad (Collapsible) -->
            <Border Grid.Row="3" Margin="12,0,12,8"
                    Visibility="{Binding IsScientificMode, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Scientific Row 1 -->
                    <Button Grid.Row="0" Grid.Column="0" Content="sin" Command="{Binding UnaryOperationCommand}" CommandParameter="sin" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="0" Grid.Column="1" Content="cos" Command="{Binding UnaryOperationCommand}" CommandParameter="cos" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="0" Grid.Column="2" Content="tan" Command="{Binding UnaryOperationCommand}" CommandParameter="tan" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="0" Grid.Column="3" Content="ln" Command="{Binding UnaryOperationCommand}" CommandParameter="ln" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="0" Grid.Column="4" Content="log" Command="{Binding UnaryOperationCommand}" CommandParameter="log" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="0" Grid.Column="5" Content="n!" Command="{Binding UnaryOperationCommand}" CommandParameter="n!" Style="{StaticResource ScientificButtonStyle}" Height="40" />

                    <!-- Scientific Row 2 -->
                    <Button Grid.Row="1" Grid.Column="0" Content="x^y" Command="{Binding OperationCommand}" CommandParameter="^" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="1" Grid.Column="1" Content="π" Command="{Binding InsertConstantCommand}" CommandParameter="π" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="1" Grid.Column="2" Content="e" Command="{Binding InsertConstantCommand}" CommandParameter="e" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="1" Grid.Column="3" Content="x²" Command="{Binding UnaryOperationCommand}" CommandParameter="x²" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="1" Grid.Column="4" Content="√x" Command="{Binding UnaryOperationCommand}" CommandParameter="√" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                    <Button Grid.Row="1" Grid.Column="5" Content="1/x" Command="{Binding UnaryOperationCommand}" CommandParameter="1/x" Style="{StaticResource ScientificButtonStyle}" Height="40" />
                </Grid>
            </Border>

            <!-- ROW 4: Main Standard Keypad Grid -->
            <Grid Grid.Row="4" Margin="12,0,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Utility Controls -->
                <Button Grid.Row="0" Grid.Column="0" Content="CE" Command="{Binding ClearEntryCommand}" Style="{StaticResource ClearButtonStyle}" />
                <Button Grid.Row="0" Grid.Column="1" Content="C" Command="{Binding ClearCommand}" Style="{StaticResource ClearButtonStyle}" />
                <Button Grid.Row="0" Grid.Column="2" Content="⌫" Command="{Binding BackspaceCommand}" Style="{StaticResource ClearButtonStyle}" />
                <Button Grid.Row="0" Grid.Column="3" Content="÷" Command="{Binding OperationCommand}" CommandParameter="÷" Style="{StaticResource OperatorButtonStyle}" />

                <!-- Row 1: Numbers 7, 8, 9 & Operator × -->
                <Button Grid.Row="1" Grid.Column="0" Content="7" Command="{Binding NumberCommand}" CommandParameter="7" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="1" Grid.Column="1" Content="8" Command="{Binding NumberCommand}" CommandParameter="8" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="1" Grid.Column="2" Content="9" Command="{Binding NumberCommand}" CommandParameter="9" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="1" Grid.Column="3" Content="×" Command="{Binding OperationCommand}" CommandParameter="×" Style="{StaticResource OperatorButtonStyle}" />

                <!-- Row 2: Numbers 4, 5, 6 & Operator - -->
                <Button Grid.Row="2" Grid.Column="0" Content="4" Command="{Binding NumberCommand}" CommandParameter="4" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="2" Grid.Column="1" Content="5" Command="{Binding NumberCommand}" CommandParameter="5" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="2" Grid.Column="2" Content="6" Command="{Binding NumberCommand}" CommandParameter="6" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="2" Grid.Column="3" Content="-" Command="{Binding OperationCommand}" CommandParameter="-" Style="{StaticResource OperatorButtonStyle}" />

                <!-- Row 3: Numbers 1, 2, 3 & Operator + -->
                <Button Grid.Row="3" Grid.Column="0" Content="1" Command="{Binding NumberCommand}" CommandParameter="1" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="3" Grid.Column="1" Content="2" Command="{Binding NumberCommand}" CommandParameter="2" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="3" Grid.Column="2" Content="3" Command="{Binding NumberCommand}" CommandParameter="3" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="3" Grid.Column="3" Content="+" Command="{Binding OperationCommand}" CommandParameter="+" Style="{StaticResource OperatorButtonStyle}" />

                <!-- Row 4: Sign ±, Number 0, Decimal ., Equals = -->
                <Button Grid.Row="4" Grid.Column="0" Content="±" Command="{Binding ToggleSignCommand}" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="4" Grid.Column="1" Content="0" Command="{Binding NumberCommand}" CommandParameter="0" Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="4" Grid.Column="2" Content="." Command="{Binding NumberCommand}" CommandParameter="." Style="{StaticResource NumberButtonStyle}" />
                <Button Grid.Row="4" Grid.Column="3" Content="=" Command="{Binding EqualsCommand}" Style="{StaticResource EqualsButtonStyle}" />
            </Grid>

            <!-- FLOATING HISTORY DRAWER OVERLAY -->
            <Border Grid.Row="1" Grid.RowSpan="4"
                    Background="{DynamicResource BgObsidianBrush}"
                    BorderBrush="{DynamicResource BorderGlowBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,20,20"
                    Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVisConverter}}">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="CALCULATION HISTORY" Foreground="{DynamicResource NeonCyanBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource HeaderIconButton}" Content="✕" ToolTip="Close History" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12,10"
                                            Background="{DynamicResource BgCardBrush}"
                                            BorderBrush="{DynamicResource BorderGlowBrush}"
                                            BorderThickness="1" CornerRadius="10" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Expression}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Text="{Binding Result}" Foreground="{DynamicResource NeonCyanBrush}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Command="{Binding ClearHistoryCommand}" Style="{StaticResource ClearButtonStyle}" Height="40" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑 " FontSize="14" />
                            <TextBlock Text="Clear History" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
